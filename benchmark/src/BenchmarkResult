package com.benchmark;

import java.time.Instant;

/**
 * Immutable record of a single benchmark run (one algorithm, one input
 * size, one iteration). {@link BenchmarkRunner} produces these; {@link
 * ResultWriter} consumes them.
 */
public final class BenchmarkResult {

    private final String algorithmName;
    private final int inputSize;
    private final int iteration;
    private final long executionTimeNs;
    private final double memoryUsedKb;
    private final Instant timestamp;

    public BenchmarkResult(String algorithmName,
                            int inputSize,
                            int iteration,
                            long executionTimeNs,
                            double memoryUsedKb) {
        this.algorithmName = algorithmName;
        this.inputSize = inputSize;
        this.iteration = iteration;
        this.executionTimeNs = executionTimeNs;
        this.memoryUsedKb = memoryUsedKb;
        this.timestamp = Instant.now();
    }

    public String getAlgorithmName() {
        return algorithmName;
    }

    public int getInputSize() {
        return inputSize;
    }

    public int getIteration() {
        return iteration;
    }

    public long getExecutionTimeNs() {
        return executionTimeNs;
    }

    public double getMemoryUsedKb() {
        return memoryUsedKb;
    }

    public Instant getTimestamp() {
        return timestamp;
    }

    @Override
    public String toString() {
        return String.format(
            "%s | size=%d | iter=%d | time=%d ns | mem=%.2f KB",
            algorithmName, inputSize, iteration, executionTimeNs, memoryUsedKb);
    }
}
