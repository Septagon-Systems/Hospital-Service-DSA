package com.benchmark;

import java.io.IOException;
import java.io.UncheckedIOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.util.List;

/**
 * Persists {@link BenchmarkResult} data - either to a CSV file for
 * offline analysis (e.g. in a spreadsheet) or to a database.
 */
public final class ResultWriter {

    private ResultWriter() {
        // static utility class
    }

    /**
     * Writes all results to a CSV file at {@code filePath}, one row per
     * (algorithm, size, iteration) measurement.
     */
    public static void exportToCsv(List<BenchmarkResult> results, String filePath) {
        StringBuilder sb = new StringBuilder();
        sb.append("algorithmName,inputSize,iteration,executionTimeNs,memoryUsedKb,timestamp\n");

        for (BenchmarkResult r : results) {
            sb.append(escape(r.getAlgorithmName())).append(',')
              .append(r.getInputSize()).append(',')
              .append(r.getIteration()).append(',')
              .append(r.getExecutionTimeNs()).append(',')
              .append(String.format("%.3f", r.getMemoryUsedKb())).append(',')
              .append(r.getTimestamp())
              .append('\n');
        }

        try {
            Path path = Path.of(filePath);
            if (path.getParent() != null) {
                Files.createDirectories(path.getParent());
            }
            Files.writeString(path, sb.toString(), StandardCharsets.UTF_8);
        } catch (IOException e) {
            throw new UncheckedIOException("Failed to write CSV to " + filePath, e);
        }
    }

    /**
     * Persists a single result to a database via JDBC. The caller supplies
     * an open {@link Connection} (connection pooling / lifecycle is left
     * to the application). Expects a table created roughly as:
     *
     * <pre>
     * CREATE TABLE benchmark_results (
     *   id               BIGSERIAL PRIMARY KEY,
     *   algorithm_name   VARCHAR(255) NOT NULL,
     *   input_size       INT NOT NULL,
     *   iteration        INT NOT NULL,
     *   execution_time_ns BIGINT NOT NULL,
     *   memory_used_kb   DOUBLE PRECISION NOT NULL,
     *   recorded_at      TIMESTAMP NOT NULL
     * );
     * </pre>
     */
    public static void saveToDatabase(Connection connection, BenchmarkResult result) throws SQLException {
        String sql = "INSERT INTO benchmark_results "
            + "(algorithm_name, input_size, iteration, execution_time_ns, memory_used_kb, recorded_at) "
            + "VALUES (?, ?, ?, ?, ?, ?)";

        try (PreparedStatement stmt = connection.prepareStatement(sql)) {
            stmt.setString(1, result.getAlgorithmName());
            stmt.setInt(2, result.getInputSize());
            stmt.setInt(3, result.getIteration());
            stmt.setLong(4, result.getExecutionTimeNs());
            stmt.setDouble(5, result.getMemoryUsedKb());
            stmt.setTimestamp(6, Timestamp.from(result.getTimestamp()));
            stmt.executeUpdate();
        }
    }

    /**
     * Overload matching the brief's suggested single-arg signature. Left
     * unimplemented on purpose: persistence requires a live DB connection
     * that this module doesn't own. Wire it up to {@link #saveToDatabase
     * (Connection, BenchmarkResult)} once a connection/DataSource is
     * available in the host application.
     */
    public static void saveToDatabase(BenchmarkResult result) {
        throw new UnsupportedOperationException(
            "saveToDatabase(BenchmarkResult) requires a configured Connection/DataSource. "
            + "Use saveToDatabase(Connection, BenchmarkResult) instead.");
    }

    private static String escape(String value) {
        if (value.contains(",") || value.contains("\"") || value.contains("\n")) {
            return "\"" + value.replace("\"", "\"\"") + "\"";
        }
        return value;
    }
}
